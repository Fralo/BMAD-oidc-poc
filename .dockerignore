.git
.gitignore
.dockerignore

# BMAD framework + planning artifacts — not needed in any image build context
_bmad/
_bmad-output/

# Local tooling (cloned archetype lives here)
tools/

# E2E test artefacts — never bake test output into images
e2e/test-results/

# Language artifacts
**/node_modules
**/__pycache__
**/*.pyc
**/dist
**/.pytest_cache
**/.coverage
**/.uv
**/.venv

# BFF-specific: tests, dev docs, build caches (mirrors services/bff/.dockerignore,
# which only applies when the per-service context is used — see Story 1.3).
# With the root build context (Story 1.14) only this file applies.
services/bff/tests/
services/bff/docs/
services/bff/.ruff_cache/
services/bff/.githooks/

# Resource Server-specific: tests, dev docs, archetype-emitted helpers
# (mirrors services/resource-server/.dockerignore, which is unused with
# the root build context — see Story 3.1 / D4). Keep build-context tight.
services/resource-server/tests/
services/resource-server/docs/
services/resource-server/.ruff_cache/
services/resource-server/.githooks/
services/resource-server/compose/
services/resource-server/scripts/

# Local environment files (never bake secrets into images)
**/.env
**/.env.local

# Editor / OS
**/.DS_Store
**/.idea
**/.vscode
