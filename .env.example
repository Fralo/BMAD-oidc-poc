# =============================================================================
# .env.example  —  Reading Time Estimator
# Copy this file to `.env` at the repo root before running `docker compose up`.
# Every variable here is consumed by one or more compose services; later stories
# will wire each service to the subset it needs via `env_file:`.
# Never commit a real `.env`; it is gitignored.
# =============================================================================

# --- Keycloak (Story 1.2) ----------------------------------------------------
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# --- BFF (Stories 1.3 – 1.7) -------------------------------------------------
# OIDC client secret shared with Keycloak's `bmad-books-bff` client.
BFF_CLIENT_SECRET=change-me
# Async SQLite URL for the BFF database (sessions + books).
BFF_DATABASE_URL=sqlite+aiosqlite:////data/bff.db
# Public base URL of the BFF, used for OIDC redirect URIs and SPA fetches.
BFF_BASE_URL=http://localhost:8000

# --- Resource Server (Stories 3.x – 4.x) -------------------------------------
# Async SQLite URL for the RS database (reading-speed values).
RS_DATABASE_URL=sqlite+aiosqlite:////data/rs.db

# --- OIDC (consumed by BFF and RS) -------------------------------------------
OIDC_ISSUER_URL=http://keycloak:8080/realms/bmad-books
OIDC_JWKS_URL=http://keycloak:8080/realms/bmad-books/protocol/openid-connect/certs
# Browser-facing authorize URL — used in the 302 from /auth/login.
# Must resolve from the host browser (Keycloak's `KC_HOSTNAME=localhost`).
OIDC_AUTHORIZE_URL_BROWSER=http://localhost:8080/realms/bmad-books
# Audience is what the realm's `aud-resource-server` mapper adds to access tokens
# (NOT the client id — see Story 1.2 dev notes / D2). The RS validates `aud`
# against this value in Stories 3.2/3.3.
OIDC_AUDIENCE=bmad-books-resource-server
OIDC_CLIENT_ID=bmad-books-bff

# --- BFF cookies (Stories 1.5 – 1.6) -----------------------------------------
BFF_SESSION_COOKIE_NAME=bff_session
BFF_CSRF_COOKIE_NAME=bff_csrf
# Keep `false` for local http://; flip to `true` behind HTTPS.
BFF_SESSION_COOKIE_SECURE=false

# --- Test-reset endpoints (Stories 1.12 / 3.4 — gated by e2e profile) --------
# Both services expose POST /v1/test/reset ONLY when ENABLE_TEST_RESET=true.
# The Playwright harness flips this in the e2e profile; never enable in prod.
ENABLE_TEST_RESET=false
TEST_RESET_TOKEN=change-me
