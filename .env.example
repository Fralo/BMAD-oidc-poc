# =============================================================================
# .env.example  —  Reading Time Estimator (single canonical entry point)
# Copy this file to `.env` at the repo root before running `docker compose up`.
# This file carries ONLY operator-edited values: secrets and overrides an
# operator may need to change per environment. Topology constants
# (OIDC URLs, base URLs, DB paths, cookie names, archetype defaults) live in
# compose/app.yml and compose/infra.yml `environment:` blocks because they
# are not operator-tunable in this local-docker topology.
# Never commit a real `.env`; it is gitignored.
# =============================================================================

# --- Keycloak admin (compose/infra.yml bridges these to KC_BOOTSTRAP_*) -------
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# --- BFF OIDC client secret (must match the realm at keycloak/realm-bmad-books.json) ---
# Shared with Keycloak's `bmad-books-bff` confidential client. The realm JSON
# imports the same literal value at container start; if you change one, change
# both or the OIDC token exchange will fail with `invalid_client`.
BFF_CLIENT_SECRET=change-me

# --- BFF cookie hardening flag (override for HTTPS deployments) --------------
# Keep `false` for local http://localhost runs. Flip to `true` behind HTTPS.
BFF_SESSION_COOKIE_SECURE=false

# --- Test-reset endpoints (required only by the `e2e` profile) ---------------
# `compose/app.e2e.yml` sets ENABLE_TEST_RESET=true on the BFF and RS and
# requires TEST_RESET_TOKEN (the overlay uses `${TEST_RESET_TOKEN:?...}` so
# `just e2e-up` fails fast with a clear error if this is unset).
# The default stack does NOT mount the /v1/test/reset routes — they are inert
# unless the e2e overlay is applied via `just e2e-up`.
TEST_RESET_TOKEN=change-me
