# services/bff/.env.example
#
# Per-service template loaded by the BFF container via `env_file:
# services/bff/.env` in compose/app.yml. The repo-root `.env.example`
# (Story 1.1) is the canonical AR29 enumeration; this file mirrors only
# the subset the BFF actually consumes. Production deployments populate
# `services/bff/.env` (gitignored) from the repo-root `.env`.
#
# Never commit `services/bff/.env` (or any real secrets) — only this
# template is tracked.

# --- Application meta (archetype defaults; safe to keep as-is) --------------
APP_NAME=bff
DEBUG=false
# LOG_LEVEL=INFO             (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# LOG_MODE=plain             (plain | json)
# PROFILE=default            (default | mock)
# ROOT_PATH=                 (set when behind a reverse-proxy path prefix)

# --- AR29: BFF runtime --------------------------------------------------------
# Canonical async SQLAlchemy URL. The container mounts the `bff_data` named
# volume at /data, so this default works for the `default` and `e2e` profiles
# out of the box. For `dev` profile / host runs, override to a local path.
BFF_DATABASE_URL=sqlite+aiosqlite:////data/bff.db
# OIDC client secret — shared with Keycloak's `bmad-books-bff` client.
# Consumed by the OIDC plugin in Story 1.5; required-fail-fast even in 1.3.
BFF_CLIENT_SECRET=change-me
# Public base URL of the BFF — used for OIDC redirect URIs (Story 1.5).
BFF_BASE_URL=http://localhost:8000

# --- AR29: OIDC (set by Story 1.2's realm; do not rename) --------------------
OIDC_ISSUER_URL=http://keycloak:8080/realms/bmad-books
OIDC_JWKS_URL=http://keycloak:8080/realms/bmad-books/protocol/openid-connect/certs
OIDC_AUDIENCE=bmad-books-resource-server
OIDC_CLIENT_ID=bmad-books-bff
# Browser-facing authorize URL — used in the 302 from /auth/login.
# Must resolve from the host browser (Keycloak's `KC_HOSTNAME=localhost`).
OIDC_AUTHORIZE_URL_BROWSER=http://localhost:8080/realms/bmad-books

# --- AR29: BFF cookies (consumed by Stories 1.5 – 1.6) -----------------------
BFF_SESSION_COOKIE_NAME=bff_session
BFF_CSRF_COOKIE_NAME=csrf_token
# Keep `false` for local http://; flip to `true` behind HTTPS.
BFF_SESSION_COOKIE_SECURE=false

# --- AR29: Test-reset endpoint (Story 1.12 — gated by e2e profile) -----------
ENABLE_TEST_RESET=false
TEST_RESET_TOKEN=change-me

# --- AR29: BFF → Resource Server (Story 3.5) --------------------------------
# Compose-internal hostname for the Resource Server (matches the service name
# in compose/app.yml). In dev (host runs), override to the local RS port (e.g.,
# http://localhost:8001). Required-fail-fast at startup: must be non-empty and
# start with http:// or https://.
RS_BASE_URL=http://resource-server:8000
