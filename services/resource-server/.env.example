# Application
APP_NAME=resource-server
DEBUG=false
# LOG_LEVEL=INFO             (default — DEBUG, INFO, WARNING, ERROR, CRITICAL)
# LOG_MODE=plain             (default — plain | json; invalid values fall back to plain)
# PROFILE=default            (default — default | mock; selects service implementations: default = database-backed, mock = in-memory)

# OpenTelemetry
# OTEL_EXPORT_ENABLED=false    (default — set true to export traces to collector)
# OTEL_EXPORTER_ENDPOINT=http://localhost:4317  (default — gRPC OTLP collector)
# OTEL_SERVICE_NAME=resource-server           (default — service.name resource attribute)

# Reverse proxy
# ROOT_PATH=               (default — empty; set to path prefix when behind a reverse proxy, e.g. /api/v1)

# CORS
# CORS_ENABLED=false
# CORS_ALLOW_ORIGINS=                        (comma-separated list, e.g. http://localhost:3000,https://app.example.com)
# CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
# CORS_ALLOW_HEADERS=Authorization,Content-Type
# CORS_ALLOW_CREDENTIALS=false
# CORS_EXPOSE_HEADERS=                       (comma-separated list, optional)
#
# Note: when CORS_ALLOW_CREDENTIALS=true, CORS_ALLOW_ORIGINS cannot include '*'.

# Database
# DATABASE_URL=             (optional — omit or leave empty for SQLite in-memory; set for MariaDB/PostgreSQL/etc.)
# Example for MariaDB: mysql+pymysql://user:password@host:3306/dbname
# Special characters (@ : / % etc.) in the URL must be percent-encoded.

# Authentication / Authorization
# AUTH_TYPE=none                       (default — none | entra)
# AUTH_EXTERNAL_ISSUER=                (required when AUTH_TYPE=entra)
# AUTH_EXTERNAL_AUDIENCE=              (optional; if empty, audience check is skipped)
# AUTH_EXTERNAL_DISCOVERY_URI=         (required unless AUTH_EXTERNAL_JWKS_URI is set)
# AUTH_EXTERNAL_JWKS_URI=              (required unless AUTH_EXTERNAL_DISCOVERY_URI is set)
# AUTH_EXTERNAL_TOKEN_URI=             (optional; required only for client_credentials / OBO flows)
# AUTH_EXTERNAL_CLIENT_ID=             (optional; required only for client_credentials / OBO flows)
# AUTH_EXTERNAL_CLIENT_SECRET=         (optional; required only for client_credentials / OBO flows)
#
# Auth outbound HTTP behavior
# AUTH_HTTP_TIMEOUT_SECONDS=10
# AUTH_HTTP_RETRY_ATTEMPTS=1
