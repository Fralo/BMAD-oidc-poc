# services/resource-server/.env.example
#
# Per-service template loaded by the RS container via `env_file:
# services/resource-server/.env` in compose/app.yml. The repo-root
# `.env.example` (Story 1.1) is the canonical AR29 enumeration; this file
# mirrors only the subset the RS actually consumes. Production deployments
# populate `services/resource-server/.env` (gitignored) from the repo-root
# `.env` or the deployment secrets store.
#
# Never commit `services/resource-server/.env` (or any real secrets) — only
# this template is tracked.

# --- Application meta (archetype defaults; safe to keep as-is) --------------
APP_NAME=resource-server
DEBUG=false
# LOG_LEVEL=INFO             (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# LOG_MODE=plain             (plain | json)
# PROFILE=default            (default | mock)
# ROOT_PATH=                 (set when behind a reverse-proxy path prefix)

# --- AR29: RS runtime --------------------------------------------------------
# Canonical async SQLAlchemy URL. The container mounts the `rs_data` named
# volume at /data, so this default works for the `default`, `dev`, and `e2e`
# profiles out of the box. For host runs, override to a local path.
RS_DATABASE_URL=sqlite+aiosqlite:////data/rs.db

# --- AR29: OIDC (set by Story 1.2's realm; do not rename) --------------------
# Used by /health (JWKS reachability, Story 3.1) and by Story 3.2's JWT
# validation (PyJWT + PyJWKClient). All three are validated as
# required-fail-fast at AppSettings construction — boot will refuse to
# proceed if any is empty / whitespace-only.
#
# OIDC_AUDIENCE MUST equal "bmad-books-resource-server" — the value Story
# 1.2's realm-as-code mints into the access token's `aud` claim via the
# audience mapper on the `bmad-books-bff` client.
# OIDC_ISSUER_URL must match Keycloak's `KC_HOSTNAME` (compose/infra.yml:19) —
# the iss claim Keycloak emits in signed tokens is `http://localhost:8080/...`.
# OIDC_JWKS_URL is used server-side to fetch signing keys via compose DNS,
# so it stays at `http://keycloak:8080/...`. Same browser-vs-server pattern
# the BFF uses (`OIDC_AUTHORIZE_URL_BROWSER` vs `OIDC_ISSUER_URL`).
OIDC_ISSUER_URL=http://localhost:8080/realms/bmad-books
OIDC_JWKS_URL=http://keycloak:8080/realms/bmad-books/protocol/openid-connect/certs
OIDC_AUDIENCE=bmad-books-resource-server

# --- AR29: AUTH_TYPE — bearer-token validation plugin (archetype seam) ------
# Selects how the RS validates Authorization: Bearer tokens. Valid values:
#   - none         → no validation; principal is a synthetic admin. Tests /
#                    local dev only. (archetype default)
#   - entra        → Azure Entra ID (vestigial; left for cross-service
#                    archetype parity until coordinated cleanup post-Story 4.1)
#   - oidc_bearer  → Keycloak via JWKS (Story 3.2). REQUIRED for production /
#                    e2e — validates JWT signature against the cached JWKS at
#                    OIDC_JWKS_URL and enforces OIDC_ISSUER_URL + OIDC_AUDIENCE.
# When unset, defaults to "none" (matches the archetype). Compose profiles
# default + dev + e2e SHOULD set AUTH_TYPE=oidc_bearer (the actual wiring
# flips in Story 3.3 / 3.6 once a scope-gated handler exists to consume it).
#AUTH_TYPE=oidc_bearer

# --- AR29: Test-reset endpoint (Story 3.4 — gated by e2e profile) -----------
# Story 3.4 mounts POST /v1/test/reset when ENABLE_TEST_RESET=true. Until
# then, the route is not registered and the env vars are inert on the
# default / dev profiles.
ENABLE_TEST_RESET=false
TEST_RESET_TOKEN=change-me
